# Database - Oracle Autonomous Database
# Formato: oracle://user:password@host:port/service_name
# Para ATP/ADW con wallet: oracle://user:password@description=(address=(protocol=tcps)(port=1522)(host=adb.region.oraclecloud.com))(connect_data=(service_name=xxxxx_high.adb.oraclecloud.com))(security=(ssl_server_cert_dn="CN=adwc.uscom-east-1.oraclecloud.com,OU=Oracle BMCS US,O=Oracle Corporation,L=Redwood City,ST=California,C=US"))
DATABASE_URL="oracle://admin:your_password@your_adb_connection_string"

# Server
PORT=5000
NODE_ENV=development

# JWT (genera una clave secreta segura)
JWT_SECRET=tu_clave_secreta_aqui
