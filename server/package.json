{
  "name": "server",
  "version": "1.0.0",
  "description": "Backend API para Mi Agenda",
  "main": "dist/index.js",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--openssl-legacy-provider ts-node-dev --respawn --transpile-only -r dotenv/config src/index.ts",
    "build": "tsc",
    "prestart": "node scripts/bootstrap-wallet.js",
    "start": "cross-env NODE_OPTIONS=--openssl-legacy-provider node dist/index.js",
    "db:init": "cross-env NODE_OPTIONS=--openssl-legacy-provider node -e \"require('./dist/database/init').initDatabase()\""
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "oracledb": "^6.3.0",
    "uuid": "^9.0.1",
    "cross-env": "^7.0.3",
    "adm-zip": "^0.5.16"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.10.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/uuid": "^9.0.7",
    "typescript": "^5.3.3",
    "ts-node-dev": "^2.0.0"
  }
}
